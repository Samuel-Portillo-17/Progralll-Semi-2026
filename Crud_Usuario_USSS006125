from mysql.connector.errors import Error
import Conexion


db = Conexion.Conexion()


class crud_clientes:

    def consultar(self, buscar):
        return db.consultar(
            """
            SELECT idUsuario, usuario, clave, nombre, direccion, telefono
            FROM usuarios
            WHERE codigo LIKE %s OR nombre LIKE %s
            ORDER BY nombre
            """,
            (f"%{buscar}%", f"%{buscar}%")
        )

    def consultar_empresas(self):
        return db.consultar(
            """
            SELECT idCliente, codigo, nombre, tipo
            FROM clientes
            WHERE tipo = 'empresa'
            ORDER BY nombre
            """
        )

    def administrar(self, datos):
        try:
            accion = datos.get('accion', 'nuevo')

            if accion == 'nuevo':
                sql = """
                    INSERT INTO usuarios(usuario, clave, nombre, direccion, telefono)
                    VALUES(%s, %s, %s, %s, %s)
                """
                valores = (
                    datos['usuario'], datos['clave'], datos['nombre'],
                    datos['direccion'], datos['telefono']
                )

            elif accion == 'modificar':
                sql = """
                    UPDATE usuarios
                    SET codigo=%s, nombre=%s, direccion=%s,
                        telefono=%s, email=%s, tipo=%s
                    WHERE idUsuario=%s
                """
                valores = (
                  datos['usuario'], datos['clave'], datos['nombre'],
                                      datos['direccion'], datos['telefono']
                    datos['idUsuario']
                )

            elif accion == 'eliminar':
                sql = "DELETE FROM usuarios WHERE idUsuario=%s"
                valores = (datos['idUsuario'],)

            else:
                return "Accion no valida"

            return db.ejecutar(sql, valores)

        except Error as e:
            return f"Error al guardar el usuario: {e}"
        except KeyError as e:
            return f"Falta el campo: {e}"